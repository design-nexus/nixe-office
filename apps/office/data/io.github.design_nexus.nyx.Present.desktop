[Desktop Entry]
Type=Application
Name=Present
GenericName=Presentation
Comment=Make and show slides; opens PowerPoint files
Exec=nyx-present %f
Icon=io.github.design_nexus.nyx.Present
Terminal=false
Categories=Office;Presentation;GTK;
Keywords=presentation;slides;slideshow;powerpoint;pptx;odp;
MimeType=application/x-nyx-present;application/x-nexus-present;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.oasis.opendocument.presentation;
StartupNotify=true
StartupWMClass=io.github.design_nexus.nyx.Present
