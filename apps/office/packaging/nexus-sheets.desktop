[Desktop Entry]
Type=Application
Name=Nexus Sheets
GenericName=Spreadsheet
Comment=Budgets, lists and charts in spreadsheets; opens Excel and CSV files
Exec=nexus-sheets %f
Icon=x-office-spreadsheet
Terminal=false
Categories=Office;Spreadsheet;GTK;
Keywords=spreadsheet;budget;excel;xlsx;csv;table;chart;ods;
MimeType=application/x-nexus-sheets;text/csv;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.oasis.opendocument.spreadsheet;
StartupNotify=true
StartupWMClass=io.github.design_nexus.Sheets
